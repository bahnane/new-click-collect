OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_ENDPOINT="https://<provider-endpoint>"
OBJECT_STORAGE_ACCESS_KEY_ID="change_me"
OBJECT_STORAGE_SECRET_ACCESS_KEY="change_me"
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PRESIGN_EXPIRES_SECONDS=900

IMAGE_ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,image/avif"
IMAGE_MAX_UPLOAD_BYTES=8388608
IMAGE_ORPHAN_CLEANUP_ENABLED=true
IMAGE_ORPHAN_RETENTION_HOURS=48
IMAGE_ORPHAN_CLEANUP_BATCH_SIZE=100

INVITE_TOKEN_EXPIRES_IN="7d"
EMAIL_VERIFICATION_EXPIRES_IN="1d"
PASSWORD_RESET_EXPIRES_IN="30m"
ORDER_CANCEL_CUTOFF_MINUTES=60