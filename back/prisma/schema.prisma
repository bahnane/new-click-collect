generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  MERCHANT
  CUSTOMER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum AppLanguage {
  fr
  ar
}

enum EmailTemplate {
  MERCHANT_INVITATION
  PASSWORD_RESET
  CUSTOMER_EMAIL_VERIFICATION
  CUSTOMER_ORDER_PENDING
  MERCHANT_NEW_ORDER
  CUSTOMER_ORDER_STATUS
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY
  COLLECTED
  CANCELLED
}

enum BusinessType {
  HANOUTE
  PATISSERIE
}

enum MerchantProfileStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CHANGES_REQUESTED
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique @db.VarChar(191)
  passwordHash       String   @db.VarChar(255)
  role               Role     @default(CUSTOMER)
  status             UserStatus @default(ACTIVE)
  preferredLanguage  AppLanguage @default(fr)
  mustChangePassword Boolean  @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  merchantProfile    MerchantProfile?
  refreshTokens      RefreshToken[]
  resetTokens        PasswordResetToken[]
  inviteTokens       InviteToken[]
  reviewedSubmissions ProductSubmission[] @relation("SubmissionReviewer")
  carts              Cart[]
  customerOrders     Order[]

  @@map("users")
}

model MerchantProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  slug        String   @unique @db.VarChar(140)
  storeName   String   @db.VarChar(120)
  businessType BusinessType
  status      MerchantProfileStatus @default(APPROVED)
  description String?  @db.Text
  phone       String?  @db.VarChar(30)
  address     String?  @db.VarChar(255)
  city        String?  @db.VarChar(100)
  zipCode     String?  @db.VarChar(10)
  latitude    Float?   @db.Double
  longitude   Float?   @db.Double
  isActive             Boolean  @default(true)
  pickupSlotCapacity   Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  openingHours MerchantOpeningHour[]
  pickupHours  MerchantPickupHour[]
  storeOffers StoreOffer[]
  productSubmissions ProductSubmission[]
  carts       Cart[]
  orders      Order[]
  pickupSlots PickupSlot[]

  @@index([businessType])
  @@map("merchant_profiles")
}

model MerchantOpeningHour {
  id          String   @id @default(cuid())
  merchantId  String
  dayOfWeek   Weekday
  startHour   Int
  endHour     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, dayOfWeek])
  @@index([merchantId, dayOfWeek])
  @@map("merchant_opening_hours")
}

model MerchantPickupHour {
  id          String   @id @default(cuid())
  merchantId  String
  dayOfWeek   Weekday
  startHour   Int
  endHour     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, dayOfWeek])
  @@index([merchantId, dayOfWeek])
  @@map("merchant_pickup_hours")
}

enum SaleUnit {
  KG
  LITER
  UNIT
  PORTION
}

enum ProductSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductCategory {
  id          String   @id @default(cuid())
  parentId    String?
  imageAssetId String?
  name        String   @unique @db.VarChar(80)
  slug        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(191)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent                 ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  imageAsset             ImageAsset?       @relation("CategoryImageAsset", fields: [imageAssetId], references: [id], onDelete: SetNull)
  children               ProductCategory[] @relation("CategoryTree")
  products               Product[]         @relation("ProductMainCategory")
  submissions            ProductSubmission[] @relation("SubmissionMainCategory")
  productsAsSubCategory  Product[]         @relation("ProductSubCategory")
  submissionsAsSubCategory ProductSubmission[] @relation("SubmissionSubCategory")

  @@index([isActive])
  @@index([parentId])
  @@index([imageAssetId])
  @@map("product_categories")
}

// Catalogue global de produits (normalisé, partagé entre tous les marchands)
model Product {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(191)
  subCategoryId String?
  imageAssetId String?
  description  String?  @db.Text
  saleUnit     SaleUnit @default(UNIT)
  priceInCents Int?
  categoryId   String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   ProductCategory @relation("ProductMainCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory ProductCategory? @relation("ProductSubCategory", fields: [subCategoryId], references: [id], onDelete: SetNull)
  imageAsset ImageAsset? @relation("ProductImageAsset", fields: [imageAssetId], references: [id], onDelete: SetNull)
  storeOffers StoreOffer[]
  submissions ProductSubmission[]
  orderItems  OrderItem[]

  @@unique([name, categoryId])
  @@index([name])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([imageAssetId])
  @@map("products")
}

model ImageAsset {
  id             String   @id @default(cuid())
  storageProvider String  @db.VarChar(40)
  storageBucket  String?  @db.VarChar(120)
  storageKey     String   @unique @db.VarChar(500)
  cdnUrl         String   @db.VarChar(2048)
  altText        String?  @db.VarChar(500)
  focalPointX    Float?   @db.Double
  focalPointY    Float?   @db.Double
  dominantColor  String?  @db.VarChar(20)
  mimeType       String?  @db.VarChar(120)
  width          Int?
  height         Int?
  sizeBytes      Int?
  checksumSha256 String?  @db.VarChar(128)
  blurDataUrl    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variants         ImageAssetVariant[]
  productCategories ProductCategory[] @relation("CategoryImageAsset")
  products         Product[]          @relation("ProductImageAsset")

  @@index([storageProvider])
  @@map("image_assets")
}

model ImageAssetVariant {
  id         String   @id @default(cuid())
  assetId    String
  variantKey String   @db.VarChar(80)
  storageKey String   @db.VarChar(500)
  cdnUrl     String   @db.VarChar(2048)
  format     String?  @db.VarChar(20)
  width      Int?
  height     Int?
  sizeBytes  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  asset ImageAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, variantKey])
  @@index([assetId])
  @@map("image_asset_variants")
}

// Proposition de produit soumise par un marchand pour validation admin
model ProductSubmission {
  id                String                  @id @default(cuid())
  merchantId        String
  name              String                  @db.VarChar(191)
  subCategoryId     String?
  description       String?                 @db.Text
  saleUnit          SaleUnit                @default(UNIT)
  priceInCents      Int?
  categoryId        String
  status            ProductSubmissionStatus @default(PENDING)
  rejectionReason   String?                 @db.VarChar(500)
  reviewedAt        DateTime?
  reviewedByUserId  String?
  approvedProductId String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  merchant        MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category        ProductCategory @relation("SubmissionMainCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory     ProductCategory? @relation("SubmissionSubCategory", fields: [subCategoryId], references: [id], onDelete: SetNull)
  reviewedByUser  User?           @relation("SubmissionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  approvedProduct Product?        @relation(fields: [approvedProductId], references: [id], onDelete: SetNull)

  @@unique([merchantId, categoryId, name, status])
  @@index([merchantId, status])
  @@index([status, createdAt])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([reviewedByUserId])
  @@index([approvedProductId])
  @@map("product_submissions")
}

// Offre d'un marchand pour un produit du catalogue
model StoreOffer {
  id           String   @id @default(cuid())
  merchantId   String
  productId    String
  priceInCents Int?
  minOrderQty  Decimal  @default(1) @db.Decimal(10, 3)
  stepQty      Decimal  @default(1) @db.Decimal(10, 3)
  maxOrderQty  Decimal?               @db.Decimal(10, 3)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([merchantId, productId])
  @@index([merchantId, isActive])
  @@index([merchantId, createdAt])
  @@map("store_offers")
}

model Cart {
  id          String   @id @default(cuid())
  customerId  String
  merchantId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant MerchantProfile? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@unique([customerId, merchantId])
  @@index([merchantId])
  @@index([customerId])
  @@map("carts")
}

model CartItem {
  id           String   @id @default(cuid())
  cartId       String
  storeOfferId String
  quantity     Decimal  @db.Decimal(10, 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart       Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  storeOffer StoreOffer @relation(fields: [storeOfferId], references: [id], onDelete: Cascade)

  @@unique([cartId, storeOfferId])
  @@index([cartId])
  @@index([storeOfferId])
  @@map("cart_items")
}

model PickupSlot {
  id          String   @id @default(cuid())
  merchantId  String
  startsAt    DateTime
  endsAt      DateTime
  currentOrders Int    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@unique([merchantId, startsAt, endsAt])
  @@index([merchantId, startsAt])
  @@index([merchantId, isActive])
  @@map("pickup_slots")
}

model Order {
  id                   String      @id @default(cuid())
  customerId           String
  merchantId           String
  pickupSlotId         String
  status               OrderStatus @default(PENDING)
  estimatedTotalInCents Int
  finalTotalInCents    Int?
  pickupStartsAt       DateTime
  pickupEndsAt         DateTime
  note                 String?     @db.Text
  cancellationReason   String?     @db.Text
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  collectedAt          DateTime?
  cancelledAt          DateTime?

  customer   User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant   MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  pickupSlot PickupSlot      @relation(fields: [pickupSlotId], references: [id], onDelete: Restrict)
  items      OrderItem[]

  @@index([customerId, createdAt])
  @@index([merchantId, status])
  @@index([merchantId, createdAt])
  @@index([pickupSlotId])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  storeOfferId    String
  productId       String
  productName     String   @db.VarChar(191)
  saleUnit        SaleUnit
  quantity        Decimal  @db.Decimal(10, 3)
  unitPriceInCents Int
  lineTotalInCents Int
  createdAt       DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeOffer StoreOffer @relation(fields: [storeOfferId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([storeOfferId])
  @@index([productId])
  @@map("order_items")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])

  @@map("password_reset_tokens")
}

model InviteToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])

  @@map("invite_tokens")
}

model EmailDelivery {
  id                String              @id @default(cuid())
  template          EmailTemplate
  recipientEmail    String              @db.VarChar(191)
  language          AppLanguage         @default(fr)
  payload           Json
  status            EmailDeliveryStatus @default(PENDING)
  attemptCount      Int                 @default(0)
  maxAttempts       Int                 @default(5)
  nextAttemptAt     DateTime            @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  lastError         String?             @db.Text
  providerMessageId String?             @db.VarChar(255)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([nextAttemptAt])
  @@index([template, createdAt])
  @@map("email_deliveries")
}