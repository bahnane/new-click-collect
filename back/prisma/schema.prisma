generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  MERCHANT
  CUSTOMER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique @db.VarChar(191)
  passwordHash       String   @db.VarChar(255)
  role               Role     @default(CUSTOMER)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean  @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  merchantProfile    MerchantProfile?
  refreshTokens      RefreshToken[]
  resetTokens        PasswordResetToken[]
  inviteTokens       InviteToken[]

  @@map("users")
}

model MerchantProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  storeName   String   @db.VarChar(120)
  description String?  @db.Text
  phone       String?  @db.VarChar(30)
  address     String?  @db.VarChar(255)
  city        String?  @db.VarChar(100)
  zipCode     String?  @db.VarChar(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeOffers StoreOffer[]

  @@map("merchant_profiles")
}

enum SaleUnit {
  KG
  G
  LITER
  UNIT
  PORTION
}

// Catalogue global de produits (normalisé, partagé entre tous les marchands)
model Product {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(191)
  description String?  @db.Text
  saleUnit    SaleUnit @default(UNIT)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  storeOffers StoreOffer[]

  @@index([name])
  @@map("products")
}

// Offre d'un marchand pour un produit du catalogue
model StoreOffer {
  id           String   @id @default(cuid())
  merchantId   String
  productId    String
  priceInCents Int
  minOrderQty  Decimal  @default(1) @db.Decimal(10, 3)
  stepQty      Decimal  @default(1) @db.Decimal(10, 3)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([merchantId, productId])
  @@index([merchantId, isActive])
  @@map("store_offers")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])

  @@map("password_reset_tokens")
}

model InviteToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])

  @@map("invite_tokens")
}